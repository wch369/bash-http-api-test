{
  "method": "POST",
  "API_PORT": 12345,
  "endpoint": "/repos/${REPO_OWNER}/${REPO_NAME}/issues",
  "headers": {
    "Authorization": "${AUTH_TYPE} ${AUTH_TOKEN}",
    "Accept": "${DEFAULT_ACCEPT}",
    "Content-Type": "${DEFAULT_CONTENT_TYPE}",
    "X-GitHub-Api-Version": "2022-11-28"
  },
  "query_params": {},
  "body": {
    "title": "${ISSUE_TITLE}",
    "body": "${ISSUE_BODY}",
    "assignee": "${ASSIGNEE}",
    "snd_dt": "${to_day}"
  },
  "description": "Create a new GitHub issue"
}
