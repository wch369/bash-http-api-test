# API Server (prefer API_HOST+API_PORT; API_BASE_URL is fallback)
API_HOST="api.github.com"
API_PORT=""
API_SCHEMA="https"
API_BASE_URL="https://api.github.com"
API_VERSION="v1"
TIMEOUT="30"

# Authentication
AUTH_TOKEN="ghp_your_token_here"
AUTH_TYPE="Bearer"

# Default Headers
DEFAULT_ACCEPT="application/vnd.github+json"
DEFAULT_CONTENT_TYPE="application/json"

# Request defaults
DEFAULT_METHOD="GET"
FOLLOW_REDIRECTS="true"
VERIFY_SSL="true"

# Logging and output
LOG_RESPONSES="true"
PRETTY_JSON="true"

# Common variables for templates
USERNAME="octocat"
REPO_OWNER="octocat"
REPO_NAME="Hello-World"
ISSUE_TITLE="Test Issue"
ISSUE_BODY="This is a test issue"
ASSIGNEE="octocat"
SEARCH_QUERY="language:bash stars:>1000"
SORT_BY="stars"
PER_PAGE="10"