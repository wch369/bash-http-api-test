# Production environment
API_BASE_URL="https://api.github.com"
API_VERSION="v1"
TIMEOUT="30"

AUTH_TOKEN="ghp_production_token_here"
AUTH_TYPE="Bearer"

DEFAULT_ACCEPT="application/vnd.github+json"
DEFAULT_CONTENT_TYPE="application/json"

DEFAULT_METHOD="GET"
FOLLOW_REDIRECTS="true"
VERIFY_SSL="true"

LOG_RESPONSES="true"
PRETTY_JSON="true"

USERNAME="prod-user"
REPO_OWNER="production-org"
REPO_NAME="main-repo"
ISSUE_TITLE="Production Issue"
ISSUE_BODY="Issue from production"
ASSIGNEE="prod-owner"
SEARCH_QUERY="language:bash stars:>5000"
SORT_BY="stars"
PER_PAGE="50"